{
  "name": "tienda",
  "version": "1.0.0",
  "scripts": {
    "start": "cds-serve",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "watch-pedidos": "cds watch --open pedidos/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds": "^10.2.2"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@types/node": "^24.19.2",
    "cds-plugin-ui5": "^0.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
